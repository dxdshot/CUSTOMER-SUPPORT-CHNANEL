{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "outDir": "public/widget",
    "rootDir": "src/widget",
    "declaration": true,
    "types": [],
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "src/widget/**/*.ts"
  ]
}
